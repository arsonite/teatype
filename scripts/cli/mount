# Standard-library imports
import os
import subprocess

# Third-party imports
from teatype.cli import BaseCLI
from teatype.logging import *

class Mount(BaseCLI):
    def meta(self):
        return {
            'name': 'mount',
            'shorthand': 'mt',
            'help': 'Mount a remote directory via SSHFS into ~/remote/<host>/<directory>',
            'arguments': [
                {
                    'name': 'target',
                    'help': 'Remote host as [user@]host (user falls back to your ssh config)',
                    'required': True
                },
                {
                    'name': 'remote-path',
                    'help': 'Absolute directory on the remote host',
                    'required': True
                }
            ],
            'flags': [
                {
                    'name': 'flush',
                    'shorthand': 'f',
                    'help': 'Unmount instead of mounting',
                    'required': False
                }
            ]
        }

    def execute(self):
        target = self.get_argument('target')
        remote_path = self.get_argument('remote-path')
        host = target.split('@')[-1]
        mountpoint = os.path.join(os.path.expanduser('~'), 'remote', host, os.path.basename(remote_path.rstrip('/')) or 'root')

        if os.path.ismount(mountpoint):
            subprocess.run(['fusermount', '-u', mountpoint])
        if self.get_flag('flush'):
            success(f'Unmounted {mountpoint}')
            return

        os.makedirs(mountpoint, exist_ok=True)
        result = subprocess.run([
            'sshfs', f'{target}:{remote_path}', mountpoint,
            '-o', 'reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,cache=no,follow_symlinks,direct_io,no_readahead'
        ])
        if result.returncode != 0 or not os.path.ismount(mountpoint):
            err(f'Failed to mount {remote_path} at {mountpoint}.', exit=True)
        success(f'Mounted {remote_path} at {mountpoint}')

if __name__ == '__main__':
    Mount()